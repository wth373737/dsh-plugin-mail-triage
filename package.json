{
  "name": "dsh-plugin-mail-triage",
  "version": "1.0.2",
  "type": "module",
  "description": "Mail triage and safe cleanup for DeepSeek Harness: incremental read-only scan, rule engine plus local-model classification, triage report, explicit approval, then move-to-Trash only.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
