    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "test"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "imapflow": "^2.10.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mail",
    "imap",
    "triage"
